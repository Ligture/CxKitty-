# CxKitty Web UI Docker Image
FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# 复制项目文件
COPY pyproject.toml poetry.lock* ./
COPY . .

# 安装Python依赖
RUN pip install --no-cache-dir \
    flask flask-socketio pillow \
    requests qrcode pyyaml beautifulsoup4 lxml \
    pycryptodome yarl dataclasses-json jsonpath-python \
    opencv-python numpy ddddocr rich openai

# 创建必要的目录
RUN mkdir -p session logs export faces

# 暴露端口
EXPOSE 5000

# 设置环境变量
ENV FLASK_APP=webui.py
ENV PYTHONUNBUFFERED=1

# 启动命令
CMD ["python3", "webui.py"]
