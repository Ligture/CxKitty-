  #gemini无apikey web版
  - type: GeminiWebSearcher
    proxy_enable: false #使用代理
    proxy: "http://127.0.0.1:7897"
    Secure_1PSID: "*" #gemini cookie中获取
    Secure_1PSIDTS: "*" #gemini cookie中获取
    model: "G-3.1-PRO" #模型 可选:G-3.1-PRO G-3.0-FLASH-THINKING G-3.0-FLASH
    system_prompt: "system_prompt:你是一个学习通答题助手,你会得到一些有关题目,你需要回答这些题目,包括单选题,多选题,判断题,多选题至少选择两个选项,用逗号分隔答案.答案尽量通过网络搜索确认.输出格式:单选题：只输出选项字母 - 判断题：只输出“对”或“错” - 多选题：只输出选项字母，用逗号分隔.请确保每个选择都严格符合题干限定的主题范围，不扩大不缩小。只回复答案，不要输出除答案以外任何内容."
    prompt: "请回答下这个{type}：\n{value}\n{options}" 
    # {type} ：题目类型 (单选题、多选题 等等)
    # {value}：题干
    # {options}：选项文本（eg:"选项：\nA. assurance;B. insurance;C. requirement;D. issure"），如果题目没有选项（如填空题），则为空