# 基本配置

# 是否开启多会话模式
multi_session: true
# 是否开启姓名手机号打码
mask_acc: true
# TUI 最大显示高度 null: 自适应高度
tui_max_height: 25
# 尝试拉取预先上传的人脸图片
fetch_uploaded_face: true
# 会话存档路径
session_path: "session/"
# 日志文件路径
log_path: "logs/"
# 试题导出路径
export_path: "export/"
# 人脸图片路径
face_image_path: "faces/"

# --------------------

# 任务执行器配置
# 视频
video:
  # 使能
  enable: true
  # 完成等待时间
  wait: 15
  # 倍速
  speed: 1.0
  # 视频播放汇报率 (没事别改)
  report_rate: 58
  # 刷课时下载视频(视频转录的前置条件, 仅在 transcript.enable 开启时生效)
  download: true

# 作业 (章节测验)
work:
  # 使能
  enable: true
  # 是否进行试题导出 可以将 `enable`设置为 false, 从而进行 dry run
  export: true
  # 完成等待时间
  wait: 15
  # 未匹配选项是否随机选择
  fallback_fuzzer: false
  # 作答失败后是否保存
  fallback_save: true

# 文档
document:
  # 使能
  enable: true
  # 完成等待时间
  wait: 15

# 考试
exam:
  # 未匹配选项是否随机选择
  fallback_fuzzer: false
  # 提交前延迟时间
  persubmit_delay: 15
  # 是否需要交互式确认交卷 自动交卷: false 手动确认: true
  confirm_submit: true
# --------------------

# 视频转录管道 (下载视频 -> ffmpeg 提取音频 -> 本地 SenseVoiceSmall 转录 -> 章节文稿供 AI 作答)
# 设计说明见 docs/video-transcript-plan.md
# 依赖安装: 执行 scripts/install-asr.ps1 (需 Python 3.11/3.12, torch + funasr 体积较大)
transcript:
  # 使能 (关闭时完全不影响原有刷课流程)
  enable: false
  # 模型根目录, 需包含 sensevoice-small/ 与 fsmn-vad/ 两个子目录
  model_root: "D:/Project/search_via_bilibili/models"
  # 推理设备 auto: 有 cuda 用 cuda, 否则 cpu
  device: "auto"
  # SenseVoice 识别语言 auto/zh/en/yue/ja/ko
  language: "auto"
  # 是否启用逆文本正则化(数字、标点)
  use_itn: true
  # 转录缓存目录 (object_id.json)
  cache_path: "transcripts/"
  # 视频 / 音频临时目录 (转录完成后按下面开关清理)
  video_path: "videos/"
  audio_path: "audios/"
  # 转录完成后是否保留视频 (false 时删除, 转录失败会保留以便重试)
  keep_video: false
  # 转录完成后是否保留音频
  keep_audio: false

# --------------------

#选择是否启用代理ip
proxies: 
  #使能
  enable: false
  #Http IP http://127.0.0.1:7897
  HTTP: "http://127.0.0.1:7897"
  #Https IP http://127.0.0.1:7897
  HTTPS: "http://127.0.0.1:7897"

# --------------------

# 搜索器选择 (可同时使用多个搜索器, 以 yaml 语法中 list 格式添加, `type`字段决定搜索器类型)
